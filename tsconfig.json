{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["esnext"],
    "types": ["bun"],
    // The private library is optional, so isn't a dependency. Bun resolves this when running too, not just `tsc`.
    "paths": {
      "tnw-metro-api-private": ["../tnw-metro-api-private"]
    },

    "strict": true,
    // Parts of `strict` which the code doesn't pass yet, so should be enabled once it does
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "drizzle.config.ts"]
}